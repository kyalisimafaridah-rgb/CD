# =============================================================================
# CareDesk - Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values. Every var below is read in
# server/_core/env.ts. Sections marked "optional" degrade gracefully when
# unset - the app runs without them, just with that feature inert.

# -----------------------------------------------------------------------
# REQUIRED - core app
# -----------------------------------------------------------------------

# MySQL connection string (e.g. PlanetScale, Railway MySQL, or local).
# Supabase Postgres connection string (Project Settings → Database → URI).
# Prefer the Transaction pooler (port 6543) for the running app on Render:
#   postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# Use the direct connection (port 5432) when running drizzle-kit migrate/push locally.
DATABASE_URL=

# Secret used to sign session JWTs. Generate a long random string, e.g.:
#   openssl rand -base64 48
# Changing this invalidates all existing sessions (everyone gets logged out).
JWT_SECRET=

# "development" enables Vite's dev server; "production" serves the built
# static files. Railway/most hosts set this automatically.
NODE_ENV=production

# Port the server listens on. Most hosts (Railway, Render, etc) set this
# automatically - only set manually for local development if needed.
PORT=3000

# Public base URL of this app (no trailing slash), used to build links in
# emails (e.g. staff invite links in Phase 3). Example: https://app.example.com
APP_URL=


# -----------------------------------------------------------------------
# SMS - Africa's Talking (optional, but required for any SMS feature:
# appointment reminders, payment receipts, debt reminders)
# -----------------------------------------------------------------------

# Use "sandbox" for Africa's Talking's free testing environment, or your
# live username for production.
AT_USERNAME=sandbox

# Your Africa's Talking API key (from the AT dashboard).
AT_API_KEY=


# -----------------------------------------------------------------------
# EMAIL - Resend (optional: welcome emails, future staff invite emails)
# -----------------------------------------------------------------------

# From https://resend.com - free tier covers 3,000 emails/month.
RESEND_API_KEY=

# Must be a verified sender on your Resend account. The default
# "onboarding@resend.dev" works without domain verification for testing.
RESEND_FROM_EMAIL="CareDesk <onboarding@resend.dev>"


# -----------------------------------------------------------------------
# FILE STORAGE - Cloudflare R2 (optional: only needed if/when a feature
# stores files, e.g. exports or attachments)
# -----------------------------------------------------------------------

# Cloudflare account ID (found in the Cloudflare dashboard URL or sidebar).
CF_ACCOUNT_ID=

# R2 API token credentials (Cloudflare dashboard -> R2 -> Manage API Tokens).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Name of the R2 bucket to use.
R2_BUCKET_NAME=

# Optional: a public URL for the bucket (custom domain, or the R2.dev URL
# with public access enabled). If unset, files are served via short-lived
# presigned URLs instead.
R2_PUBLIC_URL=


# -----------------------------------------------------------------------
# BILLING - Lemonsqueezy (optional: subscription enforcement infrastructure
# is in place but dormant - see ENFORCE_TRIAL_EXPIRY below. These are only
# needed once you're ready to charge clinics.)
# -----------------------------------------------------------------------

# From your Lemonsqueezy dashboard (Settings -> API).
LEMON_SQUEEZY_API_KEY=

# Set when creating a webhook in Lemonsqueezy pointing to:
#   <APP_URL>/api/webhooks/lemonsqueezy
# Subscribe to: subscription_created, subscription_payment_success,
# subscription_payment_failed, subscription_cancelled, subscription_expired
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Variant IDs for each paid plan (found in Lemonsqueezy dashboard → Products → Variants).
# Copy the numeric ID shown next to each variant.
LEMON_VARIANT_CLINIC=
LEMON_VARIANT_PRO=

# Your store slug — the subdomain of your Lemonsqueezy store URL.
# e.g. if your store is at mystore.lemonsqueezy.com, set this to: mystore
LEMON_STORE_SLUG=


# -----------------------------------------------------------------------
# SUBSCRIPTION ENFORCEMENT (dormant by default)
# -----------------------------------------------------------------------

# Every clinic gets a 14-day trialEndsAt on registration regardless of this
# flag. While "false" (default), an expired trial does NOT block access -
# only a manually-suspended clinic (via the owner dashboard) is enforced.
# Set to "true" once you're ready to start enforcing trial expiry.
ENFORCE_TRIAL_EXPIRY=false


# -----------------------------------------------------------------------
# LEGACY - Manus platform (only used by server/_core/notification.ts,
# an admin-only "notify owner" endpoint with no frontend caller. Safe to
# leave unset; that endpoint will just return an error if ever called.)
# -----------------------------------------------------------------------

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=


# -----------------------------------------------------------------------
# TIMEZONE — REQUIRED for correct daily/monthly boundaries
# -----------------------------------------------------------------------

# Without this, Node defaults to UTC on Render. Uganda is UTC+3 (EAT), which
# means every "today"/"this month" calculation in the app (daily cash
# reconciliation, today's stats, the free-tier monthly patient/visit quota,
# invoice number month prefixes, revenue report date filters) rolls over up
# to 3 hours off from the clinic's actual calendar day/month. Worst case:
# a Free-tier clinic that hit last month's quota stays incorrectly blocked
# for the first ~3 hours of the new month. This one variable fixes all of
# it — every affected computation uses JS Date's local-time methods, which
# all key off this same process-wide setting. No code changes needed.
TZ=Africa/Kampala


# -----------------------------------------------------------------------
# BACKUPS (optional but recommended once you have real clinic data)
# -----------------------------------------------------------------------

# Shared secret an external cron must send to trigger a scheduled backup
# (system.runScheduledBackup dumps core tables to R2 as JSON). Generate one
# with: openssl rand -hex 32
# Point a cron (Render Cron Job, GitHub Actions scheduled workflow,
# cron-job.org, etc.) at a daily POST to your tRPC endpoint calling
# system.runScheduledBackup with { secret: "<this value>" }.
# Without this set, scheduled backups are disabled — Owner Dashboard's
# manual "Back up now" button still works regardless.
# Also requires R2 to be configured (see FILE STORAGE above) since backups
# are written there.
BACKUP_CRON_SECRET=


# -----------------------------------------------------------------------
# ERROR MONITORING - Sentry (optional but strongly recommended for production)
# -----------------------------------------------------------------------

# Get your DSN at sentry.io after creating a Node.js project.
# Free tier covers 5,000 errors/month — more than enough for early stage.
# If unset, error monitoring is silently skipped (the app still runs fine).
SENTRY_DSN=
